# Docker Compose project name; containers are named <project>-<service>-1
COMPOSE_PROJECT_NAME=webbuilder-frontend

# Host port published by docker-compose
FRONTEND_PORT=8080

# VITE_* values are public: they are bundled into the browser build. Never put secrets here.
VITE_APP_NAME=WebBuilder
VITE_API_URL=http://localhost:3000/api
